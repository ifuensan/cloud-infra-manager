# AWS Infrastructure Configuration for Peer Observer
# Copy this file to .env and adjust values as needed
#
# Usage:
#   cp env.example .env
#   # Edit .env with your values
#   ./create-aws-infra.sh

# AWS Region where resources will be created
AWS_REGION="us-east-1"

# SSH Key Pair name (will be created if doesn't exist)
KEY_NAME="peer-observer-key"

# Instance types
INSTANCE_TYPE_NODE="t3.large"      # 2 vCPU, 8 GB RAM - for Bitcoin nodes
INSTANCE_TYPE_WEB="t3.medium"      # 2 vCPU, 4 GB RAM - for web server

# Storage sizes (in GB)
BITCOIN_VOLUME_SIZE=1000           # Full node blockchain storage
BITCOIN_PRUNED_VOLUME_SIZE=50      # Pruned node storage
WEB_VOLUME_SIZE=100                # Web server storage
